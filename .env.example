# Configuração do projeto Firebase (Fluxo)
# Estes valores NÃO são segredos — o SDK web do Firebase é público por design.
# A segurança real vem das regras do Firestore (firestore.rules), não destes valores.
#
# Copie este arquivo para ".env" para desenvolvimento local, preenchendo com os
# dados do seu projeto (Firebase Console > Configurações do projeto > Seus apps > SDK).
# Em produção (GitHub Pages), esses mesmos valores são injetados pelo GitHub Actions
# a partir de "Repository variables" (Settings > Secrets and variables > Actions > Variables).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
